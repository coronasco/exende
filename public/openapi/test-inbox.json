    "/v1/inboxes/{id}/messages": {
      "get": {
        "tags": [
          "Test Inbox"
        ],
        "operationId": "listTestInboxMessages",
        "summary": "Read accepted email messages",
        "security": [
          {
            "inboxToken": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^ib_[a-f0-9]{40}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Messages in receipt order. No additional payment. Duplicate decoded content does not consume another message slot.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "inbox_id": {
                      "type": "string",
                      "pattern": "^ib_[a-f0-9]{40}$"
                    },
                    "status": {
                      "type": "string",
                      "const": "active"
                    },
                    "expires_at": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "messages": {
                      "type": "array",
                      "maxItems": 3,
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                          "id": {
                            "type": "string",
                            "pattern": "^im_[0-9a-f-]{36}$"
                          },
                          "received_at": {
                            "type": "string",
                            "format": "date-time"
                          },
                          "from": {
                            "type": "string",
                            "description": "SMTP envelope sender, not an authenticated identity."
                          },
                          "subject": {
                            "type": "string"
                          },
                          "text": {
                            "type": "string",
                            "description": "Decoded text, at most 128 KiB UTF-8; no raw HTML or attachments."
                          },
                          "text_truncated": {
                            "type": "boolean"
                          },
                          "otp": {
                            "type": [
                              "string",
                              "null"
                            ]
                          },
                          "verification_url": {
                            "type": [
                              "string",
                              "null"
                            ],
                            "format": "uri"
                          },
                          "otp_status": {
                            "type": "string",
                            "enum": [
                              "found",
                              "not_found",
                              "ambiguous"
                            ]
                          },
                          "link_status": {
                            "type": "string",
                            "enum": [
                              "found",
                              "not_found",
                              "ambiguous",
                              "not_requested"
                            ]
                          }
                        },
                        "required": [
                          "id",
                          "received_at",
                          "from",
                          "subject",
                          "text",
                          "text_truncated",
                          "otp",
                          "verification_url",
                          "otp_status",
                          "link_status"
                        ]
                      }
                    }
                  },
                  "required": [
                    "inbox_id",
                    "status",
                    "expires_at",
                    "messages"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Invalid input or cursor.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Missing or malformed private Bearer token.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
