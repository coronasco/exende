    "/v1/inboxes/{id}/wait": {
      "get": {
        "tags": [
          "Test Inbox"
        ],
        "operationId": "waitForTestInboxMessage",
        "summary": "Wait for the next accepted email",
        "description": "Event-driven wait for up to 60 seconds, maximum 4 concurrent waits per inbox. Use next_after on the next request; omit after to return the first message. Unknown cursors and repeated/unknown query parameters are rejected. A timeout is not an email-delivery failure. No extra x402 payment.",
        "security": [
          {
            "inboxToken": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^ib_[a-f0-9]{40}$"
            }
          },
          {
            "name": "timeout",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "maximum": 60,
              "default": 60
            }
          },
          {
            "name": "after",
            "in": "query",
            "schema": {
              "type": "string",
              "pattern": "^im_[0-9a-f-]{36}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Message received or wait timed out.",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "received": {
                          "type": "boolean",
                          "const": true
                        },
                        "timeout": {
                          "type": "boolean",
                          "const": false
                        },
                        "message": {
                          "type": "object",
                          "additionalProperties": false,
                          "properties": {
                            "id": {
                              "type": "string",
                              "pattern": "^im_[0-9a-f-]{36}$"
                            },
                            "received_at": {
                              "type": "string",
                              "format": "date-time"
                            },
                            "from": {
                              "type": "string",
                              "description": "SMTP envelope sender, not an authenticated identity."
                            },
                            "subject": {
                              "type": "string"
                            },
                            "text": {
                              "type": "string",
                              "description": "Decoded text, at most 128 KiB UTF-8; no raw HTML or attachments."
                            },
                            "text_truncated": {
                              "type": "boolean"
                            },
                            "otp": {
                              "type": [
                                "string",
                                "null"
                              ]
                            },
                            "verification_url": {
                              "type": [
                                "string",
                                "null"
                              ],
                              "format": "uri"
                            },
                            "otp_status": {
                              "type": "string",
                              "enum": [
                                "found",
                                "not_found",
                                "ambiguous"
                              ]
                            },
                            "link_status": {
                              "type": "string",
                              "enum": [
                                "found",
                                "not_found",
                                "ambiguous",
                                "not_requested"
                              ]
                            }
                          },
                          "required": [
                            "id",
                            "received_at",
                            "from",
                            "subject",
                            "text",
                            "text_truncated",
                            "otp",
                            "verification_url",
                            "otp_status",
                            "link_status"
                          ]
                        },
                        "next_after": {
                          "type": "string",
                          "pattern": "^im_[0-9a-f-]{36}$"
                        }
                      },
                      "required": [
                        "received",
                        "timeout",
                        "message",
                        "next_after"
                      ]
                    },
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "received": {
                          "type": "boolean",
                          "const": false
                        },
                        "timeout": {
                          "type": "boolean",
                          "const": true
                        },
                        "message": {
                          "type": "null"
                        },
                        "next_after": {
                          "type": [
                            "string",
                            "null"
                          ]
                        }
                      },
                      "required": [
                        "received",
                        "timeout",
                        "message",
                        "next_after"
                      ]
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Invalid input or cursor.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Missing or malformed private Bearer token.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
